# ─────────────────────────────────────────────────────────────────────────
# Standalone MPC boot node — environment file (single source of truth)
#
# Copy to `node.env` (gitignored) and fill the MANDATORY values, or let
# `scripts/node.sh init --party N` generate the secrets for you.
#
#   scripts/node.sh init --party 1     # auto-fills the 4 mandatory vars below
#   scripts/node.sh up                 # docker compose up (bundles NATS)
# ─────────────────────────────────────────────────────────────────────────

# ── MANDATORY ────────────────────────────────────────────────────────────

# This node's party id in the MPC group (1-indexed u16).
PARTY_ID=1

# Password for the on-disk EncryptedFileStore (AES-256-GCM + Argon2id).
KEY_STORE_PASSWORD=change-me

# Ed25519 PRIVATE seed, hex (32 bytes / 64 chars). This node's signing identity.
# Generate with: mpc-wallet --format json gen-identity
NODE_SIGNING_KEY=

# Ed25519 PUBLIC key of the gateway/orchestrator, hex (32 bytes / 64 chars).
# Must be a real curve point — `init` derives it from a generated gateway keypair
# (private half saved to infra/node/gateway.key).
GATEWAY_PUBKEY=

# ── OPTIONAL (sane defaults shown) ───────────────────────────────────────

# NATS broker URL. `init` sets this for you:
#   bundled  → nats://nats:4222   (co-located NATS container, default)
#   external → nats://<your-host>:4222
NATS_URL=nats://nats:4222

# Encrypted key-share directory inside the container (must exist at boot).
KEY_STORE_DIR=/data/keys

# HTTP health + Prometheus metrics port (also published to the host).
HEALTH_PORT=9090

# Authorization replay-cache capacity.
AUTH_CACHE_MAX_ENTRIES=10000

# Log verbosity (tracing EnvFilter syntax).
RUST_LOG=mpc_wallet_node=info

# Log format: leave unset for human-readable, set to `json` for structured logs.
# LOG_FORMAT=json
